---
layout: base.liquid
---
<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ page.date | date: '%Y-%m-%d' }}">{{ page.date | date: "%B %-d, %Y" }}</time>
    </p>
  </header>

  <div class="post-content">
    {{ content }}
  </div>

</article>

{% include "archived-comments.liquid" %}
{% include "comments.liquid" %}
