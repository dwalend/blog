---
layout: base.liquid
---
<ul class="post-list">
{% for post in collections.post reversed %}
  <li>
    <span class="post-meta">{{ post.date | date: "%B %-d, %Y" }}</span>
    <a href="{{ post.url | url }}">{{ post.data.title }}</a>
  </li>
{% else %}
  <li><span class="post-meta">No posts yet.</span></li>
{% endfor %}
</ul>
