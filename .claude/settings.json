{
  "model": "opus",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(jq:*)",
      "Bash(scala-cli:*)",
      "Bash(grep:*)",
      "WebSearch",
      "WebFetch",
      "mcp__ide__getDiagnostics",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(sort:*)",
      "Bash(chmod +x:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git ls-tree:*)",
      "Bash(git mv:*)",
      "Bash(cloc:*)",
      "Bash(nslookup:*)",
      "Bash(tee:*)",
      "Bash(perl:*)",
      "Bash(sed:*)",
      "Bash(npm run:*)",
      "Bash(npx @11ty/eleventy:*)",
      "Edit(/**)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Edit(~/projects/**/.env*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.docker/**)",
      "Task"
    ],
    "ask": [
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/strip-redundant-cd.sh\"",
            "if": "Bash(cd *)",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/approve-text-tools-in-project.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}